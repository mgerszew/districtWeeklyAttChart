{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    // try this for homeshare:  ${env:HOMESHARE} or ${env:HOMEDRIVE} or ${env:ONDDRIVE} surrounded by single quotes
    "version": "2.0.0",
    "tasks": [
        {
            "label": "buildplugin",
            "type": "shell",
            "command": "python '${env:ONEDRIVE}/Documents/Code/Python/Utilities/pluginpack.py' --input Plugin --output . --timestamp --with-version --increment-dev",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CPM Sync",
            "type": "shell",
            "command": "python -m acme_cpmsync --path Plugin/WEB_ROOT",
            "problemMatcher": [],
            "group": {
                "kind": "none",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": false
            }
        }
    ]
}